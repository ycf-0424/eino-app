# 复制为部署机 .env.prod；不要提交真实值。
APP_IMAGE=registry.example.com/my-eino-app:2026.09.19-<git-sha>
APP_PORT=18180
MYSQL_DATABASE=eino
MYSQL_ROOT_PASSWORD=replace_with_different_strong_root_password
MYSQL_USER=eino_app
MYSQL_PASSWORD=replace_with_strong_password
# 可选迁移专用 DDL 账号；附件/会话迁移命令优先使用它，应用账号保持 DML 权限。
MYSQL_MIGRATE_USER=
MYSQL_MIGRATE_PASSWORD=
MYSQL_VOLUME_NAME=eino-prod-mysql
MYSQL_VOLUME_EXTERNAL=false
ETCD_VOLUME_EXTERNAL=false
MINIO_VOLUME_EXTERNAL=false
MILVUS_VOLUME_EXTERNAL=false
APP_VOLUME_EXTERNAL=false
MINIO_ROOT_USER=replace_with_strong_minio_user
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3.5:9b
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
FEISHU_APP_ID=replace_with_feishu_app_id
FEISHU_APP_SECRET=replace_with_feishu_app_secret
FEISHU_REDIRECT_URL=https://eino.example.com/auth/callback
METRICS_TOKEN=replace_with_long_random_metrics_token
# 可选：仅开启对应附件解析 provider 时填写，并在 Compose 环境中显式透传。
ATTACHMENT_VISION_API_KEY=
ATTACHMENT_VISION_BASE_URL=
ATTACHMENT_VISION_MODEL=
ATTACHMENT_TRANSCRIPTION_API_KEY=
ATTACHMENT_TRANSCRIPTION_BASE_URL=
ATTACHMENT_TRANSCRIPTION_MODEL=
# 可选：健康探测失败时接收 POST JSON 的通知地址（飞书/企业微信机器人等）。
# ALERT_WEBHOOK_URL=
# 测试复用已有卷时才打开，并逐项确认数据来源。
# MYSQL_VOLUME_NAME=gozero_mysql_data
# MYSQL_VOLUME_EXTERNAL=true
