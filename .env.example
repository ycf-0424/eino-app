# 复制为 .env，设置实际账号密码后启用 MySQL 会话存储。
SESSION_STORE=mysql

# 火山方舟 API Key。仅在配置文件中以 ${ARK_API_KEY} 引用时才需要设置。
# 未设置而配置里引用了它时，config.Load 会立即报
# "environment variable ARK_API_KEY is not set"，不会带着空密钥发请求。
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# ARK_API_KEY=replace_with_your_ark_api_key
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eino
MYSQL_USER=eino_app
MYSQL_PASSWORD=replace_with_your_password

# 迁移专用账号（可选）。应用账号按设计只有 DML，建表/加列需要 DDL 权限，
# 因此 make db-migrate 会优先使用下面这组凭据；留空则回落到应用账号。
# 仅 cmd/session-migrate 读取，应用进程不使用。
MYSQL_MIGRATE_USER=
MYSQL_MIGRATE_PASSWORD=

# 备份与恢复演练专用账号（scripts/backup.ps1 / scripts/restore-check.ps1 使用，
# 应用进程不使用）。为什么不能用应用账号：
#   MySQL 8.0.21+ 起 mysqldump --single-transaction 会执行 FLUSH TABLES，
#   需要全局 FLUSH_TABLES（或 RELOAD）权限；应用账号只有 eino.* 的 DML，
#   会以 "Access denied ... (1227)" 失败。
# 建议权限（最小集，eino 为库名）：
#   CREATE USER 'eino_backup'@'%' IDENTIFIED BY '<口令>';
#   GRANT FLUSH_TABLES, SHOW_ROUTINE ON *.* TO 'eino_backup'@'%';
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES ON `eino`.* TO 'eino_backup'@'%';
#   GRANT ALL PRIVILEGES ON `eino_restore_check`.* TO 'eino_backup'@'%';  -- 恢复演练的临时库
MYSQL_BACKUP_USER=
MYSQL_BACKUP_PASSWORD=

# 飞书自建应用凭据（开发者后台 → 凭证与基础信息）。
# 只在 auth.enabled: true 时需要；APP_SECRET 必须通过环境变量注入，不要写进配置文件。
#
# ⚠️ 容器部署时，光填这里**不够**：compose 读 .env 只用于变量插值，不会注入容器。
#    docker-compose.milvus.yml 的 app.environment 已显式透传这三个变量，别删那几行。
#    漏掉时容器内读到空值，而 auth.local.enabled=true 让 ValidateAuth 判定
#    「至少有一种登录方式」而正常启动 —— 登录页静默少了飞书按钮，不报任何错。
#
# 飞书后台还需：① 应用发布并设置可用范围；② 权限勾选 contact:user.base:readonly
#（这是 internal/auth/feishu.go 的 FeishuScope 常量，不可配置）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与飞书后台「安全设置 → 重定向 URL」登记值完全一致（含协议、端口、路径）。
# 代码里回调路径固定是 /auth/callback，端口用容器映射出的宿主端口。
FEISHU_REDIRECT_URL=http://localhost:18180/auth/callback
