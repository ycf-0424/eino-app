# 复制为 .env，设置实际账号密码后启用 MySQL 会话存储。
SESSION_STORE=mysql

# 火山方舟 API Key。仅在配置文件中以 ${ARK_API_KEY} 引用时才需要设置。
# 未设置而配置里引用了它时，config.Load 会立即报
# "environment variable ARK_API_KEY is not set"，不会带着空密钥发请求。
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# ARK_API_KEY=replace_with_your_ark_api_key
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eino
MYSQL_USER=eino_app
MYSQL_PASSWORD=replace_with_your_password

# 迁移专用账号（可选）。应用账号按设计只有 DML，建表/加列需要 DDL 权限，
# 因此 make db-migrate 会优先使用下面这组凭据；留空则回落到应用账号。
# 仅 cmd/session-migrate 读取，应用进程不使用。
MYSQL_MIGRATE_USER=
MYSQL_MIGRATE_PASSWORD=

# 飞书自建应用凭据（开发者后台 → 凭证与基础信息）。
# 只在 auth.enabled: true 时需要；APP_SECRET 必须通过环境变量注入，不要写进配置文件。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与飞书后台「安全设置 → 重定向 URL」登记值完全一致（含协议、端口、路径）。
FEISHU_REDIRECT_URL=http://localhost:18180/auth/callback
